# Core
PORT=3001
NODE_ENV=development

# ---- Storage / driver ----
# Local dev (no Docker): leave DB_DRIVER unset → defaults to sqlite (single file,
# no external dependency). In production/Docker, use pg (see docker-compose.yml).
DB_DRIVER=sqlite
# Required only when DB_DRIVER=pg:
DATABASE_URL=

# SQLite database file (used only when DB_DRIVER=sqlite; persisted to a docker
# volume when you run via compose)
DB_PATH=./data/scheduler.db

# Directory where uploaded video files are staged before upload
STORAGE_ROOT=./storage

# ---- YouTube / OAuth ----
# Obtain these from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must include the /auth/callback path; e.g. http://localhost:3001/auth/callback
# In production set it to your domain, e.g. https://scheduler.yourdomain.com/auth/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/callback

# OAuth scopes requested at login (do not change unless you know what you're doing)
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

# ---- Worker / rate-limit behaviour ----
# Run the worker process separately: npm run worker
WORKER_TICK_MS=2000            # how often the worker polls the DB for work
MAX_CONCURRENT_UPLOADS=2       # simultaneous uploads across all channels
PER_CHANNEL_MAX_CONCURRENT=1   # simultaneous uploads per channel
# YouTube daily quota defaults to 10,000 units. A videos.insert upload costs 1600.
# This budget is tracked per channel so rotation never exceeds each channel's limit.
DEFAULT_DAILY_QUOTA=10000
UPLOAD_QUOTA_COST=1600
QUOTA_BURN_FRACTION=0.85       # don't fully exhaust a channel; leave headroom

# Exponential backoff (seconds), capped
BACKOFF_BASE=15
BACKOFF_MAX=3600               # 1 hour max backoff
MAX_RETRIES=8                  # before a job is marked exhausted

# When true, the worker prints the YouTube upload steps to logs without calling
# the network. Use this to validate scheduling + backoff logic without real
# credentials or a real Google account.
DRY_RUN=false
