{
  "name": "youtube-video-scheduler",
  "version": "0.2.0",
  "description": "Schedule videos for automatic upload to YouTube with titles, hashtags, and rate-limit-aware queuing.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "bash ./scripts/start.sh",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "dev:worker": "node --watch src/worker.js",
    "db:reset": "node scripts/reset-db.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "stop": "bash ./scripts/stop.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^154.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
